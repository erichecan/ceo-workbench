node_modules/
.env
*.log

# 运行时产物：抓到的原始数据、数据库、生成的报告都不入库，
# 只提交代码和规则。data/ 和 reports/ 目录本身用 .gitkeep 占位。
data/*
!data/.gitkeep
reports/*
!reports/.gitkeep

# 预约卡的底图是固定素材（不是抓来的运行时数据），portal.js 部署到
# Cloud Run 时要靠 git 提交的内容进镜像，必须例外放行；生成出来的卡片
# png（data/cards/output/）还是运行时产物，继续不入库。
!data/cards/
data/cards/output/
!data/cards/backgrounds/

# CEO 站点生成产物（由 npm run site 从 docs/ tasks/ finance/ 编译而来）
site/dist/

.DS_Store

# 诊断书是发给客户的，含对方昵称与生意判断，不入库
data/diagnoses/
