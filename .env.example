# 复制为 .env 后填写。.env 已在 .gitignore 里，不会入库。
# 全部留空也能跑：默认 provider=cli，走 Claude Code 订阅额度，不产生 API 费用。

# ── AI provider ──────────────────────────────────────────────────────────────
# cli       headless `claude -p`，走订阅额度，**零 API 费用**（默认，推荐）
# anthropic @anthropic-ai/sdk，按 token 计费，需要 ANTHROPIC_API_KEY
# gemini    Google Gemini REST，按 token 计费，需要 GEMINI_API_KEY
AI_PROVIDER=cli

# provider=cli 时用（默认值即下面这个，装在别处才需要改）
CLAUDE_CLI_PATH=

# provider=anthropic 时必填。⚠️ 按 token 计费，单条线索分析约 $0.01–0.03
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# provider=gemini 时必填。⚠️ 按 token 计费
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# ── 抓取 ─────────────────────────────────────────────────────────────────────
# web-access skill 的 CDP Proxy 地址。小红书登录态由那个 Chrome 持有，
# 本项目不存也不要 cookie —— 见 README「为什么不用 puppeteer」。
CDP_PROXY=http://localhost:3456

# 反封控参数。默认值抄自 scripts/xhs-probe/probe.py 的实测配置，
# ⛔ 调大等于拿账号赌，改之前先读 README「反封控」一节。
MAX_KEYWORDS_PER_RUN=5
NOTES_PER_KEYWORD=3
DELAY_BETWEEN_KEYWORDS_MIN=45
DELAY_BETWEEN_KEYWORDS_MAX=90

# 抓详情页时是否顺带截图存到 data/screenshots/（体积较大，默认关）
CAPTURE_SCREENSHOT=0
