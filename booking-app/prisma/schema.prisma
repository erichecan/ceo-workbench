generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  LOW
}

enum AppointmentStatus {
  BOOKED
  CONFIRMED
  ARRIVED
  STARTED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum BookingChannel {
  ONLINE
  OFFLINE
  WALK_IN
}

enum PriceType {
  FIXED
  FROM
  FREE
}

enum PaymentMethod {
  CASH
  CARD
  E_TRANSFER
  GIFT_CARD
  WALLET
  MIXED
  OTHER
}

model Workspace {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  taxRate          Float    @default(13) // Ontario HST——目标客户都在多伦多地区
  pointsPerEuro    Int      @default(1)
  pointsValueCents Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  locations        Location[]
  teamMembers      TeamMember[]
  clients          Client[]
  categories       ServiceCategory[]
  services         Service[]
  appointments     Appointment[]
  users            User[]
  sales            Sale[]
}

model Location {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  address     String?
  timezone    String   @default("Europe/Dublin")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  sales        Sale[]
}

model User {
  id           String  @id @default(cuid())
  workspaceId  String
  email        String  @unique
  passwordHash String
  role         Role    @default(LOW)
  teamMemberId String? @unique

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teamMember TeamMember? @relation(fields: [teamMemberId], references: [id])
}

model TeamMember {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  email          String
  role           Role     @default(LOW)
  calendarColor  String   @default("#8B5CF6")
  isBookable     Boolean  @default(true)
  isArchived     Boolean  @default(false)
  commissionRate Float    @default(0)
  createdAt      DateTime @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User?
  appointments Appointment[]
  sales        Sale[]

  @@unique([workspaceId, email])
}

model ServiceCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#8B5CF6")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  services  Service[]
}

model Service {
  id               String    @id @default(cuid())
  workspaceId      String
  categoryId       String?
  name             String
  description      String?
  priceType        PriceType @default(FIXED)
  price            Int       @default(0)
  duration         Int
  isOnlineBookable Boolean   @default(true)
  isArchived       Boolean   @default(false)

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category            ServiceCategory?     @relation(fields: [categoryId], references: [id])
  appointmentServices AppointmentService[]
  saleItems           SaleItem[]
}

model Client {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  phone       String?
  notes       String?
  isBlocked   Boolean   @default(false)
  memberSince DateTime?
  lastVisitAt DateTime?
  createdAt   DateTime  @default(now())

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appointments   Appointment[]
  sales          Sale[]
}

model Appointment {
  id           String            @id @default(cuid())
  workspaceId  String
  locationId   String
  clientId     String?
  teamMemberId String?
  startTime    DateTime
  endTime      DateTime
  status       AppointmentStatus @default(BOOKED)
  channel      BookingChannel    @default(OFFLINE)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  location   Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  client     Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  teamMember TeamMember?          @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  services   AppointmentService[]
  sale       Sale?
}

model AppointmentService {
  id            String @id @default(cuid())
  appointmentId String
  serviceId     String
  price         Int
  duration      Int

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
}

model Sale {
  id              String        @id @default(cuid())
  workspaceId     String
  locationId      String
  appointmentId   String?       @unique
  clientId        String?
  teamMemberId    String?
  subtotal        Int
  discountAmount  Int           @default(0)
  tipAmount       Int           @default(0)
  taxRate         Float         @default(0)
  taxAmount       Int           @default(0)
  giftCardAmount  Int           @default(0)
  walletAmount    Int           @default(0)
  couponAmount    Int           @default(0)
  pointsEarned    Int           @default(0)
  pointsRedeemed  Int           @default(0)
  total           Int
  paymentMethod   PaymentMethod
  notes           String?
  createdAt       DateTime      @default(now())

  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  location            Location             @relation(fields: [locationId], references: [id], onDelete: Restrict)
  appointment         Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  client              Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  teamMember          TeamMember?          @relation(fields: [teamMemberId], references: [id], onDelete: SetNull)
  items               SaleItem[]
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  serviceId String?
  name      String
  price     Int

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
}

